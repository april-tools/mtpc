#!/bin/bash

# In this script we evaluate generation throughput
# I.e. how many tokens we can generate per second (with a batch size of one)

mkdir -p $MTP_ROOT/outputs/results


device=cuda
seed=12
dataset=finewebedu10B
lm=finewebedu
num_tokens=1000

python -m mtp.generate \
	--mode stp \
	--random-seed $seed \
	--num-tokens $num_tokens \
	--device $device \
	--use-cache \
	--prompt 'A polytope' \
	data=$dataset \
	lm=$lm \
	model=stp \
	lm.model.encoder_only=false \
	| tail -n 1 \
	>> $MTP_ROOT/outputs/results/throughput.jsonl

for n in 2 4 6;
do
	for model in mtp-cp mtp-hmm;
	do
		if [[ "$model" == "mtp-cp" ]];
		then
			n_component_hs="1 4 8"
		else  # mtp-hmm
			n_component_hs="4 8"
		fi
		for n_component in $n_component_hs;
		do
			for n_enc_token in 0 1 2;
			do
				for n_enc_sum in 0 1 2;
				do
					python -m mtp.generate \
						--mode mtp \
						--random-seed $seed \
						--num-tokens $num_tokens \
						--device $device \
						--use-cache \
						--prompt 'A polytope' \
						data=$dataset \
						lm=$lm \
						lm.model.encoder_only=false \
						model=$model \
						model.n_token=$n \
						model.n_component=$n_component \
						model.mt_head_hparams.sum_transformer_n_layer=$n_enc_sum \
						model.mt_head_hparams.tok_transformer_n_layer=$n_enc_token \
						| tail -n 1 \
						>> $MTP_ROOT/outputs/results/throughput.jsonl
					python -m mtp.generate \
						--mode mtp \
						--speculative \
						--random-seed $seed \
						--num-tokens $num_tokens \
						--device $device \
						--use-cache \
						--prompt 'A polytope' \
						data=$dataset \
						lm=$lm \
						lm.model.encoder_only=false \
						model=$model \
						model.n_token=$n \
						model.n_component=$n_component \
						model.mt_head_hparams.sum_transformer_n_layer=$n_enc_sum \
						model.mt_head_hparams.tok_transformer_n_layer=$n_enc_token \
						| tail -n 1 \
						>> $MTP_ROOT/outputs/results/throughput.jsonl
				done
			done
		done
	done
done
