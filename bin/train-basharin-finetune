# 					do
# 						for freeze_unembed in true false;
# 						do
# 							for gamma in 1 .8;
# 							do
# 								for beta in 0 .9 1;
# 								do
# 									if [[ "$beta" == "0" ]];
# 									then
# 										encoder_only=true
# 									else
# 										encoder_only=false
# 									fi
# 									if (( $r == 1 )) && (( $n_enc_sum > 0 ));
# 									then
# 										continue
# 									fi
