#!/bin/bash

# In this script we evaluate generation throughput
# I.e. how many tokens we can generate per second (with a batch size of one)

mkdir -p $MTP_ROOT/outputs/results


device=cuda
seed=12
default="$MTP_ROOT/outputs/models/finewebedu10B"
# If not overriden by cli, use default
directory="${1:-$default}"

for file in $(find "$directory" -type f -name "*.pt");
do
	echo -e "Processing $file..."
	torchrun \
		--standalone \
		--nproc_per_node=1 \
		-m mtp.validate \
		--device cuda \
		--checkpoint $file | tail -n 1 >> $MTP_ROOT/outputs/results/validate_models.jsonl
done
