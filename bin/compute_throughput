#!/bin/bash

# In this script we evaluate generation throughput
# I.e. how many tokens we can generate per second (with a batch size of one)

mkdir -p $MTP_ROOT/outputs/results


device=cuda
seed=12
dataset=shakespeare_char
model=basharin
lm=finewebedu

torchrun -m mtp.generate \
	--mode stp \
	--random-seed $seed \
	--num-tokens 1000 \
	--device $device \
	--prompt 'A polytope' \
	data=$dataset \
	lm=$lm \
	model=$model \
	| tail -n 1 \
	>> $MTP_ROOT/outputs/results/throughput.jsonl
for n in 2 3 4;
do
	for r in 1 2 4;
	do
		for exp in mlp linear;
		do
			for n_enc_token in 0 1 2;
			do
				for n_enc_sum in 0 1 2;
				do
					python -m mtp.generate \
						--mode mtp \
						--random-seed $seed \
						--num-tokens 1000 \
						--device $device \
						--prompt 'A polytope' \
						data=$dataset \
						lm=$lm \
						model=$model \
						model.n_token=$n \
						model.n_component=$r \
						model.token_head.expander.expander_type=$exp \
						model.sum_weight_head.encoder.n_layer=$n_enc_sum \
						model.token_head.encoder.n_layer=$n_enc_token \
						| tail -n 1 \
						>> $MTP_ROOT/outputs/results/throughput.jsonl
					python -m mtp.generate \
						--mode mtp \
						--speculative \
						--random-seed $seed \
						--num-tokens 1000 \
						--device $device \
						--prompt 'A polytope' \
						data=$dataset \
						lm=$lm \
						model=$model \
						model.n_token=$n_token \
						model.n_component=$n_component \
						model.token_head.expander.expander_type=$exp \
						model.sum_weight_head.encoder.n_layer=$n_enc_sum \
						model.token_head.encoder.n_layer=$n_enc_token \
						| tail -n 1 \
						>> $MTP_ROOT/outputs/results/throughput.jsonl
				done
			done
		done
	done
done
