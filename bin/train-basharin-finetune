#!/bin/bash

# Reproduce Experiment 3.6 https://arxiv.org/pdf/2410.17765

seed=12
dataset=finewebedu10B
lm=finewebedu
training=finewebedu
model=basharin
device_bs=8


# for r in 1 2 4;
# do
