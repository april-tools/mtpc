#!/bin/bash

mkdir -p $MTP_ROOT/outputs/results

device=cuda
num_tokens=1024
default="$MTP_ROOT/outputs/models/"
subsample_prompts=250
prompt_source="tulu-valid"
directory="${1:-$default}"
filetag="${2:-unspecified}"
seed="${3:-42}"

export GPUS=1
export GPU=1

for file in $(find "$directory" -type f -name "*.pt" -not -path '*/.*');
do
  echo -e "Processing $file..."
  python -m mtp.generate \
    --device $device \
    --mode mtp \
    --use-cache \
    --speculative \
    --random-seed $seed \
    --subsample-prompts $subsample_prompts \
    --prompt-source $prompt_source \
    --num-tokens $num_tokens \
    --task chat \
    --checkpoint $file \
    | tail -n 1 >> "$MTP_ROOT/outputs/results/throughput_evabyte_${filetag}_${subsample_prompts}.jsonl"
done
