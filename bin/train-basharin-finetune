# done

for r in 1 2 4;
do
	for n in 4;
	do
		for exp in linear;
		do
			for n_enc_token in 0;
			do
				for n_enc_sum in 0;
				do
					for freeze_lm in true;
					do
						for freeze_unembed in true;
						do
							for gamma in .8;
							do
								for beta in .9;
								do
									if [[ "$beta" == "0" ]];
									then
										encoder_only=true
									else
										encoder_only=false
									fi
									if (( $r == 1 )) && (( $n_enc_sum > 0 ));
									then
										continue
									fi
									echo -e "
									\ntorchrun --standalone \\\
									\n		--nproc_per_node=$GPUS \\\
									\n		-m mtp.train \\\
									\n		data=$dataset \\\
									\n		training=$training \\\
									\n		lm=$lm \\\
									\n		model=$model \\\
									\n		model.n_token=$n \\\
									\n		model.n_component=$r \\\
									\n		model.model.gamma=$gamma \\\
									\n		model.model.beta=$beta \\\
									\n		model.mt_head_hparams.sum_transformer_n_layer=$n_enc_sum \\\
									\n		model.mt_head_hparams.tok_transformer_n_layer=$n_enc_token \\\
									\n		model.mt_head_hparams.expander_type=$exp \\\
									\n		model.mt_head_hparams.freeze_vocab_unembedding=$freeze_unembed \\\
									\n		lm.model.freeze=$freeze_lm \\\
									\n		lm.model.encoder_only=$encoder_only \\\
									\n		training.device_batch_size=$device_bs \\\
									\n		training.expname="n-$n-r-$r-nth-$n_enc_token-nts-$n_enc_sum-$exp"
									"
								done
							done
						done
					done
				done
			done
		done
	done
done
