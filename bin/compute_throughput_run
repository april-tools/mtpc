#!/bin/bash

# In this script we evaluate generation throughput
# I.e. how many tokens we can generate per second (with a batch size of one)

mkdir -p $MTP_ROOT/outputs/results


device=cuda
seed=12
dataset=finewebedu10B
lm=finewebedu
num_tokens=1000


python -m mtp.generate \
	--mode stp \
	--random-seed $seed \
	--num-tokens $num_tokens \
	--device $device \
	--use-cache \
	--prompt 'A polytope' \
	data=$dataset \
	lm=$lm \
	model=stp \
	lm.model.encoder_only=false \
	| tail -n 1 \
	>> $MTP_ROOT/outputs/results/throughput.jsonl


for n in 2 4 6;
do
	for model in mtp-ff mtp-cp mtp-hmm;
	do
		python -m mtp.generate \
			--mode mtp \
			--random-seed $seed \
			--num-tokens $num_tokens \
			--device $device \
			--use-cache \
			--prompt 'A polytope' \
			data=$dataset \
			lm=$lm \
    		lm.model.encoder_only=false \
			model=$model \
			model.n_token=$n \
			| tail -n 1 \
			>> $MTP_ROOT/outputs/results/throughput.jsonl

		python -m mtp.generate \
			--mode mtp \
			--speculative \
			--random-seed $seed \
			--num-tokens $num_tokens \
			--device $device \
			--use-cache \
			--prompt 'A polytope' \
			data=$dataset \
			lm=$lm \
			lm.model.encoder_only=false \
			model=$model \
			model.n_token=$n \
			| tail -n 1 \
			>> $MTP_ROOT/outputs/results/throughput.jsonl
	done
done
