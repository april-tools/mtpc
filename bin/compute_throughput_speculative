#!/bin/bash

# In this script we evaluate generation throughput
# I.e. how many tokens we can generate per second (with a batch size of one)

mkdir -p $MTP_ROOT/outputs/results


device=cuda
seed=12
num_tokens=512
# Subsample 100 prompts from spec_bench. Set to 0 to use the whole spec_bench
# Note that same random seed will imply same prompts selected from spec_bench
default="$MTP_ROOT/outputs/models/finewebedu10B"
default_subsample_prompts="200"
default_prompt_source="tulu-train"
# If not overriden by cli, use default
directory="${1:-$default}"
prompt_source="${2:-$default_prompt_source}"
subsample_prompts="${3:-$default_subsample_prompts}"

for file in $(find "$directory" -type f -name "*.pt" -not -path '*/.*');
do
	if [[ $file =~ (@0\.pt|00\.pt)$ ]]; then
		echo -e "Processing $file..."
		python -m mtp.generate \
			--device cuda \
			--mode mtp \
			--speculative \
			--random-seed $seed \
			--subsample-prompts $subsample_prompts \
			--prompt-source $prompt_source \
			--num-tokens $num_tokens \
			--target-top-p 1. \
			--draft-top-p 1. \
			--task chat \
			--use-cache \
			--compile \
			--dequantize \
			--checkpoint $file | tail -n 1 >> $MTP_ROOT/outputs/results/throughput-models-$prompt_source-ns-$subsample_prompts.jsonl
	fi
done
